# Copy this file to .env and fill in your values. .env is gitignored.
# Get a key: Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: browser to pull YouTube cookies from (helps past bot checks).
# One of: chrome / safari / firefox / edge. Leave blank to disable.
COOKIES_FROM_BROWSER=
